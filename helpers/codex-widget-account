#!/usr/bin/env python3
from pathlib import Path
import json
import os
import select
import subprocess
import sys
import time
import fcntl
import re
from urllib.parse import urlsplit

CODEX = "/usr/lib/chatgpt/resources/codex"

def emit(**kwargs):
    print(json.dumps(kwargs), flush=True)

def account():
    proc = subprocess.Popen(
        [CODEX, "app-server"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        bufsize=0
    )
    buffer = b""

    def send(obj):
        proc.stdin.write((json.dumps(obj) + "\n").encode())
        proc.stdin.flush()

    def receive(request_id):
        nonlocal buffer
        deadline = time.monotonic() + 12
        while time.monotonic() < deadline:
            ready, _, _ = select.select([proc.stdout], [], [], 0.5)
            if not ready:
                if proc.poll() is not None:
                    break
                continue
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                break
            buffer += chunk
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if msg.get("id") == request_id:
                    return msg
        raise TimeoutError("Account lookup timed out")

    try:
        send({
            "id": 1,
            "method": "initialize",
            "params": {
                "clientInfo": {
                    "name": "kde-codex-account-widget",
                    "version": "2.3"
                },
                "capabilities": {}
            }
        })
        init = receive(1)
        if "error" in init:
            raise RuntimeError("App server initialization failed")
        send({"method": "initialized", "params": {}})
        send({
            "id": 2,
            "method": "account/read",
            "params": {"refreshToken": False}
        })
        response = receive(2)
        if "error" in response:
            raise RuntimeError("Account read failed")
        result = response.get("result") or {}
        acc = result.get("account") or {}
        emit(
            status="connected" if acc else "disconnected",
            email=acc.get("email") or "",
            type=acc.get("type") or ""
        )
    finally:
        if proc.poll() is None:
            proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()

def login_worker():
    state = Path.home() / ".local/state/codex-usage-widget"
    state.mkdir(parents=True, exist_ok=True)

    lock_path = state / "login.lock"

    with lock_path.open("a+") as lock:
        os.chmod(lock_path, 0o600)

        try:
            fcntl.flock(
                lock,
                fcntl.LOCK_EX | fcntl.LOCK_NB
            )
        except BlockingIOError:
            return

        proc = subprocess.Popen(
            [CODEX, "login"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1
        )

        opened = False

        try:
            for line in proc.stdout:
                # Process OAuth URLs in memory only.
                # Never save URLs or authorization codes to logs.
                if not opened:
                    for candidate in re.findall(
                        r"https?://[^\\s<>\\\"']+",
                        line
                    ):
                        url = candidate.rstrip(".,);")
                        parsed = urlsplit(url)

                        allowed = (
                            "auth.openai.com",
                            "chatgpt.com",
                            "login.openai.com"
                        )

                        if (
                            parsed.scheme == "https"
                            and parsed.hostname in allowed
                        ):
                            subprocess.Popen(
                                ["xdg-open", url],
                                stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                start_new_session=True
                            )
                            opened = True
                            break

            proc.wait()

        finally:
            if proc.poll() is None:
                proc.terminate()

                try:
                    proc.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""

    if mode == "status":
        try:
            account()
        except Exception:
            emit(
                status="error",
                message="Could not read Codex account"
            )

    elif mode == "logout":
        try:
            result = subprocess.run(
                [CODEX, "logout"],
                capture_output=True,
                text=True,
                timeout=20
            )

            emit(
                status="success" if result.returncode == 0 else "error",
                message="Logged out" if result.returncode == 0
                        else "Logout failed"
            )

        except Exception:
            emit(
                status="error",
                message="Logout failed"
            )

    elif mode == "login":
        try:
            subprocess.Popen(
                [
                    sys.executable,
                    str(Path(__file__).resolve()),
                    "login-worker"
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True
            )

            emit(
                status="started",
                message="Opening browser login..."
            )

        except Exception:
            emit(
                status="error",
                message="Could not start browser login"
            )

    elif mode == "login-worker":
        login_worker()

    else:
        emit(
            status="error",
            message="Unknown action"
        )


if __name__ == "__main__":
    main()
